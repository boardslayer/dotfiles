{
	"schemaVersion": "0.1.0",
	"name": "GitHub Repository",
	"behavior": "create",
	"noteContentFormat": "## README\n\n{{selectorHtml:article|markdown}}\n\n",
	"properties": [
		{
			"name": "title",
			"value": "{{selector:#repo-title-component a}}",
			"type": "text"
		},
		{
			"name": "repo owner",
			"value": "{{meta:name:octolytics-dimension-user_login}}",
			"type": "text"
		},
		{
			"name": "source",
			"value": "{{url}}",
			"type": "text"
		},
		{
			"name": "description",
			"value": "{{selector:.Layout-sidebar p|first}}",
			"type": "text"
		},
		{
			"name": "tags",
			"value": "github, repo, reference, {{selector:.topic-tag|join:\\\", \\\"}}",
			"type": "multitext"
		},
		{
			"name": "parent-note/TOC",
			"value": "",
			"type": "text"
		},
		{
			"name": "release",
			"value": "",
			"type": "text"
		}
	],
	"triggers": [
		"https://github.com/",
		"https://gitlab.eurecom.fr"
	],
	"noteNameFormat": "{{selector:#repo-title-component a}} - {{selector:.Layout-sidebar p|first}}",
	"path": "Inbox/github"
}